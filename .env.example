# Use placeholders only here. Put real keys in your shell environment or a local .env.
OPENAI_API_KEY=
GROQ_API_KEY=

RAG_EMBEDDING_PROVIDER=local
RAG_GENERATION_PROVIDER=groq
RAG_EMBEDDING_MODEL=text-embedding-3-small
RAG_CHAT_MODEL=llama-3.3-70b-versatile

# Retrieval tuning.
RAG_CHUNK_SIZE=900
RAG_CHUNK_OVERLAP=150
RAG_MIN_SCORE=0.18
RAG_TOP_K=4

# Local JSON vector index.
RAG_VECTOR_STORE_PATH=data/vector_store/index.json
