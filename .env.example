# OpenAI is the intended scored path for embeddings and answer generation.
# The service also has a deterministic local mode for tests and offline demos.
OPENAI_API_KEY=

RAG_EMBEDDING_PROVIDER=openai
RAG_GENERATION_PROVIDER=openai
RAG_EMBEDDING_MODEL=text-embedding-3-small
RAG_CHAT_MODEL=gpt-4.1-mini

# Retrieval tuning.
RAG_CHUNK_SIZE=900
RAG_CHUNK_OVERLAP=150
RAG_MIN_SCORE=0.18
RAG_TOP_K=4

# Local JSON vector index.
RAG_VECTOR_STORE_PATH=data/vector_store/index.json

